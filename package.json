{
  "name": "@cgo/platform-auth",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Gemeinsamer Adapter fuer X-Auth-User-Id/-Email (nginx auth_request gegen cgo-auth) mit optionaler Signaturpruefung -- ein Fastify-Plugin, ein framework-agnostischer Next.js-Helper und die MCP-OAuth-Routen.",
  "exports": {
    "./fastify": "./dist/fastify.js",
    "./next": "./dist/next.js",
    "./mcp-oauth": "./dist/mcp-oauth.js",
    "./signature": "./dist/signature.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "@types/pg": "^8.11.10",
    "fastify": "^5.11.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  }
}
