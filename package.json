{
  "name": "@cgo/platform-auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gemeinsamer Adapter fuer X-Auth-User-Id/-Email (nginx auth_request gegen cgo-auth) -- ein Fastify-Plugin und ein framework-agnostischer Next.js-Helper.",
  "exports": {
    "./fastify": "./dist/fastify.js",
    "./next": "./dist/next.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "fastify": "^5.11.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
